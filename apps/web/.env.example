NEXT_PUBLIC_API_URL=http://localhost:4000
# Real Google sign-in: the web OAuth client id. Leave empty in development.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Shows a "Google (dev)" button that works with the API's GOOGLE_DRIVER=dev. Never in production.
NEXT_PUBLIC_DEV_GOOGLE=1
# Links to the web app open the phone app (served at /.well-known/…; see lib/app-links.ts). Leave empty until the
# app is signed: your Apple team id, and the Android signing SHA-256 fingerprints (upload key and Play app signing key).
APPLE_TEAM_ID=
ANDROID_CERT_SHA256=
