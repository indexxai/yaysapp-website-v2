# Copy to .env for local development. Production values come from the server's secret store.
NODE_ENV=development
PORT=4000
PUBLIC_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:3000
# Local replica set from `pnpm infra:up`. Staging/production: the shared indexx cluster (must be a replica set).
MONGO_URI=mongodb://127.0.0.1:27018/?replicaSet=rs0
MONGO_DB=yaychat
# Production: false, and create the users indexes deliberately.
USERS_INDEXES_ON_BOOT=true
REDIS_URL=redis://127.0.0.1:6380
JWT_SECRET=change-me-to-a-long-random-string-of-48-chars
# The dev drivers put codes in the outbox instead of sending them. Production needs twilio / ses / google / s3.
SMS_DRIVER=dev
EMAIL_DRIVER=dev
GOOGLE_DRIVER=dev
STORAGE_DRIVER=local
TEST_OUTBOX=true
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_VERIFY_SID=
# SES_REGION=us-east-1
# SES_FROM=YaysApp <no-reply@yays.app>
# GOOGLE_CLIENT_IDS=web-client-id.apps.googleusercontent.com,ios-client-id,android-client-id
# S3_BUCKET=
# S3_REGION=
# SENTRY_DSN=
