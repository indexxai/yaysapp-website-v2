# Copy to .env for local development. Production values come from the server's secret store.
NODE_ENV=development
PORT=4000
PUBLIC_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:3000
# Local replica set from `pnpm infra:up`. Staging/production: the shared indexx cluster (must be a replica set).
MONGO_URI=mongodb://127.0.0.1:27018/?replicaSet=rs0
MONGO_DB=yaychat
# Production: false, and create the users indexes deliberately.
USERS_INDEXES_ON_BOOT=true
REDIS_URL=redis://127.0.0.1:6380
JWT_SECRET=change-me-to-a-long-random-string-of-48-chars
# The dev drivers put codes in the outbox instead of sending them. Production needs twilio / ses / google / s3.
SMS_DRIVER=dev
EMAIL_DRIVER=dev
GOOGLE_DRIVER=dev
STORAGE_DRIVER=local
TEST_OUTBOX=true
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_VERIFY_SID=
# SES_REGION=us-east-1
# SES_FROM=YaysApp <no-reply@yays.app>
# GOOGLE_CLIENT_IDS=web-client-id.apps.googleusercontent.com,ios-client-id,android-client-id
# S3_BUCKET=
# S3_REGION=
# SENTRY_DSN=
# Notifications. dev keeps pushes in Redis (see /v1/_test/pushes). Production: webpush with keys from `npx web-push generate-vapid-keys`.
PUSH_DRIVER=dev
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:support@yays.app

# Voice and video calls (LiveKit, server 1.12 or newer). Leave unset and calls say they aren't available.
# LIVEKIT_URL is what apps connect to (wss://… in production); LIVEKIT_API_URL only if the API reaches it elsewhere.
# Point LiveKit's webhook at <PUBLIC_URL>/v1/livekit/webhook so dropped callers are noticed.
# LIVEKIT_URL=ws://localhost:7880
# LIVEKIT_API_KEY=devkey
# LIVEKIT_API_SECRET=secret
# CALL_RING_SECONDS=45

# Jack's AI (the light version: talk, pictures, documents). With AI_DRIVER=auto it uses OpenRouter if its key is set,
# then OpenAI; with no keys it gives labelled sample answers. Pictures use OpenAI's image model.
AI_DRIVER=auto
# OPENROUTER_API_KEY=sk-or-...
# OPENAI_API_KEY=sk-...
# AI_MODEL=openai/gpt-4o-mini          # any OpenRouter model id (or an OpenAI model name with only OPENAI_API_KEY)
# AI_IMAGE_MODEL=gpt-image-2
# AI_IMAGE_OPTIONS=1                    # pictures per request
# AI_IMAGES_PER_DAY=5
# JACK_AI_URL=https://jackai.si    # the full Jack's AI, for specialised work
# Indexx sign-in, Explore cards and the wallet.
#   dev:  a stand-in that answers like the Indexx API (any password signs in), for trying screens.
#   live: the real Indexx API at INDEXX_API_URL; people sign in with their Indexx email and password.
INDEXX_DRIVER=dev
# Test server (default): https://test.api.v1.indexx.ai/api/v1 · production: https://api.v1.indexx.ai/api/v1
# INDEXX_API_URL=https://test.api.v1.indexx.ai/api/v1

# Facebook link and sign-in. dev shows a stand-in page (development only). For real Facebook Login, create an
# app at developers.facebook.com, add <PUBLIC_URL>/v1/oauth/facebook/callback as a valid redirect URI, then:
# FACEBOOK_DRIVER=facebook
# FACEBOOK_APP_ID=...
# FACEBOOK_APP_SECRET=...
FACEBOOK_DRIVER=dev
# Where the web app runs (Facebook sends people back here).
WEB_URL=http://localhost:3000
