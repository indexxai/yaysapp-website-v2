    "@nestjs/common": "10.4.15",
    "@nestjs/core": "10.4.15",
    "@nestjs/platform-express": "10.4.15",
    "@sentry/node": "8.47.0",
    "@socket.io/redis-adapter": "8.3.0",
    "@yays/shared": "workspace:*",
    "google-auth-library": "9.15.0",
    "helmet": "8.0.0",
    "ioredis": "5.4.2",
    "jose": "5.9.6",
    "libphonenumber-js": "1.11.17",
    "livekit-server-sdk": "2.19.1",
    "mongodb": "6.12.0",
    "pino": "9.5.0",
